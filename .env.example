# Supabase project settings (Project Settings > API in the Supabase dashboard).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Server-side only (used by the Admin API to delete a user's
# account and cascade-delete their business data). Never expose this to the
# browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
